{
  "name": "slopsmith-plugin-subway-scaler",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "docker compose -f tests/e2e/docker-compose.dev.yml up",
    "dev:down": "docker compose -f tests/e2e/docker-compose.dev.yml down",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:headed": "playwright test --headed --project=chromium",
    "test:e2e:ci": "cross-env CI=true playwright test --project=chromium",
    "test:e2e:nightly": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "cross-env": "^7.0.3",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "18": "0.0.0"
  }
}
